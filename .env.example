# wisperflow configuration — copy this to `.env` and edit.

# --- Rewriter (LLM polish) ---
# "ollama" (local, free, no key)  |  "claude" (Anthropic API)  |  "none"
WISPERFLOW_REWRITER=ollama
WISPERFLOW_OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434
# Only used if WISPERFLOW_REWRITER=claude.
#ANTHROPIC_API_KEY=
#WISPERFLOW_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Whisper STT (local) ---
# tiny.en | base.en | small.en | medium.en | large-v3 (and non-.en variants).
WISPERFLOW_MODEL=base.en
WISPERFLOW_DEVICE=auto
WISPERFLOW_COMPUTE=auto
WISPERFLOW_LANG=en

# --- Hotkey ---
# Hold to record, release to transcribe.
WISPERFLOW_HOTKEY=<ctrl>+<alt>+<space>

# --- Injection ---
# auto | paste | type. Use "paste" for fastest insertion in GUI apps;
# wisperflow auto-detects terminals and types unicode there regardless.
WISPERFLOW_INJECT=paste

# --- Microphone ---
# Run `python main.py --list-devices` to see options. Accepts an index ("1")
# or a case-insensitive substring of the device name ("realtek", "hyperx").
# Leave commented to use the Windows system default.
#WISPERFLOW_INPUT_DEVICE=
# Multiplier on mic samples (1.0 = no change). Bump if Whisper misses words.
#WISPERFLOW_INPUT_GAIN=1.0

# --- Status indicator ---
# Floating pill in the bottom-right that shows recording/transcribing state.
#WISPERFLOW_INDICATOR=1
#WISPERFLOW_INDICATOR_POS=bottom-right
#WISPERFLOW_INDICATOR_W=140
#WISPERFLOW_INDICATOR_H=32
# Short beeps on state transitions (Windows only). Audible if the overlay is hidden.
#WISPERFLOW_BEEP=1
